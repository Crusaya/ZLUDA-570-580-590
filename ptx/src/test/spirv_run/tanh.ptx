.version 8.8
.target sm_75
.address_size 64

.visible .entry tanh(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .f32 value;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];
    ld.f32 value, [in_addr];
    tanh.approx.f32 value, value;
    st.f32 [out_addr], value;
    ret;
}
